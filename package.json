{
  "name": "dgi_armoury",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "gate": "tsx scripts/gate.ts",
    "gate:launch": "tsx scripts/gate.ts --launch",
    "audit": "tsx scripts/audit.ts",
    "responsive": "tsx scripts/responsive.ts",
    "icons": "tsx scripts/icons.ts",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "harden": "node scripts/harden.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:prove": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f scripts/enforcement.test.sql",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run gate",
    "verify:full": "npm run verify && npm run build && npm run audit"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "drizzle-orm": "^0.45.2",
    "next": "16.2.12",
    "pg": "^8.23.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "playwright": "^1.62.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
